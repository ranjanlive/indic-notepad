{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndicStudio product privacy notice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "effective_date",
    "summary",
    "sections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "contact_email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "paragraphs",
          "bullets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 2
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "paragraph",
                        "heading"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "items"
                  ],
                  "properties": {
                    "type": {
                      "const": "list"
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
