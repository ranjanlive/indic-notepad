{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndicStudio product metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "type", "title", "tagline", "short_description", "full_description", "status", "category", "platforms", "icon_url", "features", "screenshots_url", "change_logs", "updated"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 70},
    "type": {"enum": ["apps", "games", "tools"]},
    "title": {"type": "string", "minLength": 2, "maxLength": 80},
    "tagline": {"type": "string", "minLength": 2, "maxLength": 120},
    "short_description": {"type": "string", "minLength": 15, "maxLength": 220},
    "full_description": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "status": {"enum": ["draft", "preview", "beta", "released", "retired"]},
    "category": {"type": "string", "minLength": 2},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "tint": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "icon_url": {"type": "string", "minLength": 1},
    "social_image_url": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "package_name": {"type": ["string", "null"]},
    "content_rating": {"type": ["string", "null"]},
    "price": {"type": ["object", "null"], "additionalProperties": false, "required": ["amount", "currency", "label"], "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "label": {"type": "string"}}},
    "play_store_url": {"type": ["string", "null"]},
    "app_store_url": {"type": ["string", "null"]},
    "website_url": {"type": ["string", "null"]},
    "source_code_url": {"type": ["string", "null"]},
    "apk_file_url": {"type": ["string", "null"]},
    "support_email": {"type": ["string", "null"], "format": "email"},
    "features": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "description"], "properties": {"title": {"type": "string", "minLength": 2}, "description": {"type": "string", "minLength": 5}}}},
    "platforms": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["os", "requirements"], "properties": {"os": {"enum": ["android", "windows", "linux", "macos", "web"]}, "requirements": {"type": "string", "minLength": 3}, "architectures": {"type": "array", "items": {"type": "string"}}, "version": {"type": ["string", "null"]}, "downloads": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": {"label": {"type": "string", "minLength": 2}, "url": {"type": "string", "minLength": 1}, "size": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}, "architecture": {"type": ["string", "null"]}, "format": {"type": ["string", "null"]}}}}}}},
    "screenshots_url": {"type": "object", "additionalProperties": false, "properties": {"android_view": {"$ref": "#/$defs/shots"}, "tablet_view": {"$ref": "#/$defs/shots"}, "desktop_view": {"$ref": "#/$defs/shots"}}},
    "change_logs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["version", "date", "title", "changes"], "properties": {"version": {"type": "string"}, "date": {"type": "string", "format": "date"}, "title": {"type": "string"}, "changes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "faqs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["question", "answer"], "properties": {"question": {"type": "string"}, "answer": {"type": "string"}}}},
    "permissions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "purpose"], "properties": {"name": {"type": "string"}, "purpose": {"type": "string"}}}},
    "privacy_summary": {"type": ["string", "null"]},
    "release_note": {"type": ["string", "null"]},
    "seo": {"type": "object", "additionalProperties": false, "properties": {"title": {"type": "string", "maxLength": 90}, "description": {"type": "string", "maxLength": 220}, "noindex": {"type": "boolean"}}},
    "updated": {"type": "string", "format": "date"}
  },
  "$defs": {
    "shots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "alt", "width", "height"], "properties": {"url": {"type": "string", "minLength": 1}, "alt": {"type": "string", "minLength": 5}, "caption": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}}
  }
}
